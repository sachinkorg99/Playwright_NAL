{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2020",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "playwright/test"]
  },
  "include": ["tests", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
